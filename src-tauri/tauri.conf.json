{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance App",
  "version": "0.1.0",
  "identifier": "local.financeapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Finance App", "width": 1200, "height": 820, "minWidth": 640, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": ["app"], "category": "Finance", "shortDescription": "Local personal and House accounting" }
}